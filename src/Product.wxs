<?xml version="1.0" encoding="UTF-8"?>
<!-- Unity Sprint for Black Flag Resynced - installer (WiX 3.14). Built by build.ps1.
     v1.0.4: the Oodle library and the sprint animation are plain installed files (no encrypted payloads, nothing
     unpacked to Temp), and the custom actions are a native DLL (ModActions.cpp) instead of VBScript. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="Assassin's Creed Black Flag | Unity Sprint Mod" Language="1033" Version="1.0.4"
           Manufacturer="Niki" UpgradeCode="6E0B3F52-6C1E-4C8B-9B5A-2F7D4A1C9E31">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="$(var.Scope)" Platform="x64"
             Description="Arno's sprint for Edward in Assassin's Creed Black Flag Resynced" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPCOMMENTS" Value="Removing it puts the original game file back." />
    <Property Id="GAMEDIR">
      <?if $(var.Scope) = "perMachine" ?>
      <RegistrySearch Id="RememberGameDir" Root="HKLM" Key="Software\UnitySprintMod" Name="GameDir" Type="raw" Win64="yes" />
      <?else?>
      <RegistrySearch Id="RememberGameDir" Root="HKCU" Key="Software\UnitySprintMod" Name="GameDir" Type="raw" Win64="yes" />
      <?endif?>
    </Property>

    <!-- The game folder (GAMEDIR) only receives the patched archive and its .bak backup. The engine lives in a
         protected program folder, so a rollback can always remove it (Windows Installer will not delete from
         user-writable folders during rollback). -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="GAMEDIR" Name="Assassin's Creed Black Flag Resynced" />
        <?if $(var.Scope) = "perMachine" ?>
        <Directory Id="INSTALLFOLDER" Name="Unity Sprint Mod" />
        <?endif?>
      </Directory>
      <?if $(var.Scope) != "perMachine" ?>
      <Directory Id="LocalAppDataFolder">
        <Directory Id="INSTALLFOLDER" Name="Unity Sprint Mod" />
      </Directory>
      <?endif?>
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="Engine" Guid="3C8D2B7A-5E14-4F9A-8C61-0B9E7D2F4A15" Win64="yes">
        <File Id="SprintPatchExe" Name="SprintPatch.exe" Source="$(var.Engine)" KeyPath="yes" />
      </Component>
      <Component Id="OodleLib" Guid="B7EB311F-5337-4BFC-92AE-055402DF1D9B" Win64="yes">
        <File Id="OodleDll" Name="oo2core_9_win64.dll" Source="$(var.Lib)" KeyPath="yes" />
      </Component>
      <Component Id="SprintData" Guid="F0C8EBE6-F57A-4676-B333-611914C55E8A" Win64="yes">
        <File Id="SprintAnim" Name="Unity_Sprint_680cms.Animation" Source="$(var.Motion)" KeyPath="yes" />
      </Component>
      <Component Id="Remember" Guid="9A4E6C1D-2B83-4D57-A0F9-6E3C8B1D7F24" Win64="yes">
        <RegistryValue Root="HKMU" Key="Software\UnitySprintMod" Name="GameDir" Type="string" Value="[GAMEDIR]" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="Main" Title="Unity Sprint" Level="1">
      <ComponentRef Id="Engine" />
      <ComponentRef Id="OodleLib" />
      <ComponentRef Id="SprintData" />
      <ComponentRef Id="Remember" />
    </Feature>

    <Binary Id="ModActions" SourceFile="$(var.Obj)\ModActions.dll" />
    <CustomAction Id="CheckGameDir" BinaryKey="ModActions" DllEntry="CheckGameDir" Return="check" />
    <CustomAction Id="SetApplyMod" Property="ApplyMod" Value="[#SprintPatchExe]|[GAMEDIR]" />
    <CustomAction Id="SetRollbackMod" Property="RollbackMod" Value="[#SprintPatchExe]|[GAMEDIR]" />
    <CustomAction Id="SetRemoveMod" Property="RemoveMod" Value="[#SprintPatchExe]|[GAMEDIR]" />
    <CustomAction Id="RollbackMod" BinaryKey="ModActions" DllEntry="RollbackMod" Execute="rollback" Impersonate="no" Return="ignore" />
    <CustomAction Id="ApplyMod" BinaryKey="ModActions" DllEntry="ApplyMod" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="RemoveMod" BinaryKey="ModActions" DllEntry="RemoveMod" Execute="deferred" Impersonate="no" Return="check" />

    <InstallExecuteSequence>
      <Custom Action="SetRollbackMod" Before="RollbackMod">NOT REMOVE~="ALL"</Custom>
      <Custom Action="RollbackMod" After="InstallFiles">NOT REMOVE~="ALL"</Custom>
      <Custom Action="SetApplyMod" Before="ApplyMod">NOT REMOVE~="ALL"</Custom>
      <Custom Action="ApplyMod" After="RollbackMod">NOT REMOVE~="ALL"</Custom>
      <Custom Action="SetRemoveMod" Before="RemoveMod">REMOVE~="ALL"</Custom>
      <Custom Action="RemoveMod" Before="RemoveFiles">REMOVE~="ALL"</Custom>
    </InstallExecuteSequence>

    <WixVariable Id="WixUIBannerBmp" Value="$(var.Obj)\banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.Obj)\dialog.bmp" />
    <Binary Id="ModHero" SourceFile="$(var.Obj)\hero.bmp" />
    <Property Id="WIXUI_INSTALLDIR" Value="GAMEDIR" />

    <!-- Own welcome / progress / finish pages (sized for Segoe UI, artwork on top, progress shows the
         per-step status and time left). WixUI's ProgressDlg stays in the tables but is never shown. -->
    <InstallUISequence>
      <Show Dialog="ModWelcomeDlg" Before="ProgressDlg">NOT Installed OR PATCH</Show>
      <Show Dialog="ProgressDlg" Before="ExecuteAction">0</Show>
      <!-- WixUI's 'preparing' page flashed up during the search for earlier installs; never show it. -->
      <Show Dialog="PrepareDlg" Before="AppSearch">0</Show>
      <Show Dialog="ModProgressDlg" After="ProgressDlg" />
      <Show Dialog="ModExitDlg" OnExit="success" />
    </InstallUISequence>
    <AdminUISequence>
      <Show Dialog="ModExitDlg" OnExit="success" />
    </AdminUISequence>

    <UI Id="ModUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Segoe UI" Size="9" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Segoe UI" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Segoe UI" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <Property Id="WixUI_Mode" Value="InstallDir" />

      <DialogRef Id="BrowseDlg" />
      <DialogRef Id="CancelDlg" />
      <DialogRef Id="DiskCostDlg" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />

      <Dialog Id="ModWelcomeDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Hero" Type="Bitmap" X="0" Y="0" Width="370" Height="150" TabSkip="no" Text="ModHero" />
        <Control Id="Title" Type="Text" X="20" Y="154" Width="330" Height="40" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Bigger}Welcome to the Assassin's Creed Black Flag Resynced Unity Sprint Mod Setup" />
        <Control Id="Description" Type="Text" X="20" Y="196" Width="330" Height="36" Transparent="yes" NoPrefix="yes"
                 Text="Make sure the game is not running before you continue. Your original game file will be kept as a backup inside the game's directory." />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" Text="&amp;Back" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="&amp;Next">
          <Publish Event="NewDialog" Value="InstallDirDlg">NOT Installed</Publish>
          <Publish Event="NewDialog" Value="VerifyReadyDlg">Installed AND PATCH</Publish>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>

      <Dialog Id="ModProgressDlg" Width="370" Height="270" Title="[ProductName] Setup" Modeless="yes">
        <Control Id="Banner" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="TitleInstalling" Type="Text" X="20" Y="15" Width="250" Height="16" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="{\WixUI_Font_Title}Installing the Unity Sprint Mod">
          <Condition Action="show"><![CDATA[WixUI_InstallMode <> "Remove" AND WixUI_InstallMode <> "Repair"]]></Condition>
        </Control>
        <Control Id="TitleRepairing" Type="Text" X="20" Y="15" Width="250" Height="16" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="{\WixUI_Font_Title}Repairing the Unity Sprint Mod">
          <Condition Action="show">WixUI_InstallMode = "Repair"</Condition>
        </Control>
        <Control Id="TitleRemoving" Type="Text" X="20" Y="15" Width="250" Height="16" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="{\WixUI_Font_Title}Removing the Unity Sprint Mod">
          <Condition Action="show">WixUI_InstallMode = "Remove"</Condition>
        </Control>
        <Control Id="TextInstalling" Type="Text" X="20" Y="62" Width="330" Height="28" NoPrefix="yes" Hidden="yes"
                 Text="Please wait while the mod is being applied to your game.">
          <Condition Action="show"><![CDATA[WixUI_InstallMode <> "Remove"]]></Condition>
        </Control>
        <Control Id="TextRemoving" Type="Text" X="20" Y="62" Width="330" Height="28" NoPrefix="yes" Hidden="yes"
                 Text="Please wait while your original game file is restored.">
          <Condition Action="show">WixUI_InstallMode = "Remove"</Condition>
        </Control>
        <Control Id="StatusLabel" Type="Text" X="20" Y="100" Width="40" Height="14" NoPrefix="yes" Text="Status:" />
        <Control Id="ActionText" Type="Text" X="62" Y="100" Width="288" Height="14" NoPrefix="yes">
          <Subscribe Event="ActionText" Attribute="Text" />
        </Control>
        <Control Id="ActionData" Type="Text" X="20" Y="118" Width="330" Height="14" NoPrefix="yes">
          <Subscribe Event="ActionData" Attribute="Text" />
        </Control>
        <Control Id="ProgressBar" Type="ProgressBar" X="20" Y="140" Width="330" Height="12" ProgressBlocks="yes" Text="Progress done">
          <Subscribe Event="SetProgress" Attribute="Progress" />
        </Control>
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" Text="&amp;Back" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Disabled="yes" Text="&amp;Next" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>

      <Dialog Id="ModExitDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Hero" Type="Bitmap" X="0" Y="0" Width="370" Height="150" TabSkip="no" Text="ModHero" />
        <Control Id="TextInstalled" Type="Text" X="20" Y="160" Width="330" Height="70" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="Setup has finished. You can launch the game.&#13;&#10;&#13;&#10;Your original game file is kept as a backup named DataPC_boot_patch_01.forge.bak inside the game's directory.">
          <Condition Action="show"><![CDATA[WixUI_InstallMode <> "Remove"]]></Condition>
        </Control>
        <Control Id="TextRemoved" Type="Text" X="20" Y="160" Width="330" Height="70" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="Setup has finished. The mod has been removed and your original game file is restored.">
          <Condition Action="show">WixUI_InstallMode = "Remove"</Condition>
        </Control>
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" Text="&amp;Back" />
        <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="&amp;Finish">
          <Publish Event="EndDialog" Value="Return">1</Publish>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Disabled="yes" Text="Cancel" />
      </Dialog>

      <Dialog Id="NotGameDirDlg" Width="270" Height="95" Title="[ProductName] Setup">
        <Control Id="Icon" Type="Icon" X="15" Y="15" Width="24" Height="24" FixedSize="yes" IconSize="32" Text="WixUI_Ico_Exclam" />
        <Control Id="Text" Type="Text" X="48" Y="15" Width="207" Height="45" Text="[GAMEDIR_MSG]" />
        <Control Id="OK" Type="PushButton" X="107" Y="67" Width="56" Height="17" Default="yes" Cancel="yes" Text="OK">
          <Publish Event="EndDialog" Value="Return">1</Publish>
        </Control>
      </Dialog>

      <ProgressText Action="ApplyMod" Template="[1]">Applying the Unity Sprint Mod</ProgressText>
      <ProgressText Action="RemoveMod" Template="[1]">Restoring the original game file</ProgressText>
      <ProgressText Action="RollbackMod" Template="[1]">Undoing changes</ProgressText>

      <Publish Dialog="BrowseDlg" Control="OK" Event="DoAction" Value="WixUIValidatePath" Order="3">1</Publish>
      <Publish Dialog="BrowseDlg" Control="OK" Event="SpawnDialog" Value="InvalidDirDlg" Order="4"><![CDATA[WIXUI_INSTALLDIR_VALID<>"1"]]></Publish>

      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="ModWelcomeDlg">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="DoAction" Value="CheckGameDir" Order="2">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SpawnDialog" Value="NotGameDirDlg" Order="3"><![CDATA[GAMEDIR_OK<>"1"]]></Publish>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="4">GAMEDIR_OK="1"</Publish>
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" Order="1">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Event="SpawnDialog" Value="BrowseDlg" Order="2">1</Publish>

      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg" Order="1">NOT Installed</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ModMaintenanceDlg" Order="2">Installed AND NOT PATCH</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ModWelcomeDlg" Order="2">Installed AND PATCH</Publish>

      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="ModMaintenanceDlg">1</Publish>

      <!-- Own Repair / Remove page: WixUI's MaintenanceTypeDlg showed a greyed-out "Change" button that
           means nothing for a one-file mod. Like WixUI's page, the buttons only set WixUI_InstallMode;
           VerifyReadyDlg then runs the repair or removal. -->
      <Dialog Id="ModMaintenanceDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Banner" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="250" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}Repair or remove the mod" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="230" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="Choose what you want to do." />
        <Control Id="RepairButton" Type="PushButton" X="40" Y="65" Width="80" Height="17" Text="&amp;Repair">
          <Publish Property="WixUI_InstallMode" Value="Repair">1</Publish>
          <Publish Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
        </Control>
        <Control Id="RepairText" Type="Text" X="60" Y="85" Width="290" Height="28" NoPrefix="yes"
                 Text="Applies the mod again if the game file was replaced, for example by a game update." />
        <Control Id="RemoveButton" Type="PushButton" X="40" Y="125" Width="80" Height="17" Text="Re&amp;move">
          <Publish Property="WixUI_InstallMode" Value="Remove">1</Publish>
          <Publish Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
        </Control>
        <Control Id="RemoveText" Type="Text" X="60" Y="145" Width="290" Height="28" NoPrefix="yes"
                 Text="Removes the mod and restores your original game file." />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&amp;Back">
          <Publish Event="NewDialog" Value="MaintenanceWelcomeDlg">1</Publish>
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Disabled="yes" Text="&amp;Next" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>
    </UI>
    <UIRef Id="WixUI_Common" />
  </Product>
</Wix>
